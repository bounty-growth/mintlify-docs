{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Bounty Docs",
  "favicon": "/favicon.ico",
  "description": "Bounty Docs is the public documentation site for Bounty.",
  "colors": {
    "primary": "#1C7ED6",
    "light": "#339AF0",
    "dark": "#1864AB"
  },
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "canonical": "https://docs.bountygrowth.com",
      "og:site_name": "Bounty Docs",
      "og:title": "Bounty Docs",
      "og:description": "Bounty Docs is the public documentation site for Bounty, including integrations, product workflows, analytics, campaigns, ads, creatives, actions, agents, the Bounty CLI, and the MCP server.",
      "og:type": "website",
      "twitter:card": "summary",
      "twitter:title": "Bounty Docs",
      "twitter:description": "Public documentation for Bounty integrations, product workflows, analytics, campaigns, ads, creatives, actions, agents, the Bounty CLI, and the MCP server."
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Landing",
        "href": "https://www.bountygrowth.com/"
      },
      {
        "label": "App",
        "href": "https://app.bountygrowth.com/"
      },
      {
        "type": "github",
        "href": "https://github.com/bounty-growth/cli"
      }
    ]
  },
  "footer": {
    "links": [
      {
        "header": "Related Bounty Properties",
        "items": [
          {
            "label": "Public landing page",
            "href": "https://www.bountygrowth.com/"
          },
          {
            "label": "Authenticated app",
            "href": "https://app.bountygrowth.com/"
          },
          {
            "label": "Open-source CLI",
            "href": "https://github.com/bounty-growth/cli"
          },
          {
            "label": "Privacy Policy",
            "href": "https://www.bountygrowth.com/privacy"
          },
          {
            "label": "Terms and Conditions",
            "href": "https://www.bountygrowth.com/termsandconditions"
          }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/llm.txt",
      "destination": "/llms.txt"
    },
    {
      "source": "/security",
      "destination": "/cli/security"
    },
    {
      "source": "/guides/security",
      "destination": "/cli/security"
    },
    {
      "source": "/cli/mcp",
      "destination": "/mcp/overview"
    },
    {
      "source": "/privacy",
      "destination": "/legal",
      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "/legal",
      "permanent": true
    }
  ],
  "navigation": {
    "groups": [
      {
        "group": "Bounty App",
        "pages": ["index", "quickstart", "data-hierarchy"]
      },
      {
        "group": "Integrations",
        "pages": [
          "integrations/overview",
          "integrations/google-ads",
          "integrations/google-analytics"
        ]
      },
      {
        "group": "CLI",
        "pages": [
          "cli/overview",
          "cli/quickstart",
          "cli/installation",
          "cli/claude-codex",
          "cli/authentication",
          "cli/security",
          "cli/commands"
        ]
      },
      {
        "group": "MCP",
        "pages": ["mcp/overview"]
      },
      {
        "group": "Agent Skills",
        "pages": [
          "skills/overview",
          "skills/installing",
          "skills/catalog",
          "skills/workflows"
        ]
      },
      {
        "group": "Legal",
        "pages": [
          "legal",
          "security-controls",
          "dpa",
          "subprocessors",
          "vendor-management"
        ]
      }
    ]
  }
}
